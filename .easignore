# EAS uses this INSTEAD of .gitignore for the build upload, so it must be
# self-contained. Goal: ship only what the React Native bundle needs.

# --- standard ignores (mirror .gitignore) ---
node_modules/
.expo/
dist/
web-build/
.vscode/
.idea/
.claude/
.DS_Store
.env*
!.env.example
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
venv/
*.tmp*
# Old prototype model (gitignored, but this file replaces .gitignore); the app downloads packs instead.
assets/models/*.pte

# EAS uploads a depth-1 clone's .git unless it's listed here, and that .git holds every committed
# blob, including packs/ (model, map, icons: ~150 MB) that the rule below only removes from the tree.
.git

# Native dirs are regenerated by EAS prebuild
/ios/
/android/

# --- not part of the app bundle ---
training/
evals/
website/
worker/
tools/
docs/
tasks/
packs/

# --- store credentials: never upload as plain files ---
google-service-account.json
*.p8
*.p12
*.mobileprovision
*.keystore
