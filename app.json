{
  "expo": {
    "name": "Critterboard",
    "slug": "critterboard",
    "scheme": "critterboard",
    "version": "1.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icons/icon-butterfly_1024x1024.png",
    "splash": {
      "image": "./assets/splashes/splash-stickerbug_1170x2532.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.critterboard.ios",
      "infoPlist": {
        "NSCameraUsageDescription": "Critterboard uses the camera to identify bugs on-device. Photos never leave your phone.",
        "NSPhotoLibraryUsageDescription": "Pick an existing photo of a bug to identify it on-device. We never upload your library.",
        "NSLocationWhenInUseUsageDescription": "Optional. Lets Critterboard prefer species that live near you. City-level fuzz, never shared unless you opt in.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.critterboard.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon-butterfly_1024x1024.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Critterboard uses the camera to identify bugs on-device.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick an existing photo of a bug to identify it on-device.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Lets Critterboard prefer species that live near you."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-notifications",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "994cdd33-0e47-46f8-863b-04f32014d983"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/994cdd33-0e47-46f8-863b-04f32014d983"
    }
  }
}
