{
  "name": "critterboard",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "description": "Critterboard — offline insect ID with sass. React Native + TypeScript port of the handoff prototype.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo start --android",
    "android:device": "expo run:android --device",
    "ios": "expo start --ios",
    "ios:sim": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:dev": "eas build --profile development",
    "build:dev-device": "eas build --profile development-device",
    "build:dev-ios": "eas build --platform ios --profile development-device",
    "build:dev-android": "eas build --platform android --profile development-device",
    "build:preview": "eas build --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "llama.rn": "^0.12.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-executorch": "^0.9.3",
    "react-native-executorch-expo-resource-fetcher": "^0.9.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@maplibre/maplibre-gl-style-spec": "26.2.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.2.17",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.2",
    "eas-cli": "^24.8.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "llama.rn"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
