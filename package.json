{
  "name": "critterboard",
  "version": "1.4.0",
  "private": true,
  "description": "Critterboard — offline insect ID with sass. React Native + TypeScript port of the handoff prototype.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "evalite",
    "eval:watch": "evalite --watch",
    "build:dev": "eas build --profile development",
    "build:dev-device": "eas build --profile development-device",
    "build:dev-ios": "eas build --platform ios --profile development-device",
    "build:dev-android": "eas build --platform android --profile development-device",
    "build:preview": "eas build --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.10",
    "@expo/dom-webview": "57.0.0",
    "@expo/metro-runtime": "~57.0.3",
    "@presidio-dev/hai-guardrails": "^1.12.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "ai": "^7.0.18",
    "expo": "~57.0.4",
    "expo-asset": "~57.0.3",
    "expo-build-properties": "~57.0.3",
    "expo-camera": "~57.0.1",
    "expo-dev-client": "~57.0.5",
    "expo-file-system": "~57.0.0",
    "expo-gl": "~57.0.1",
    "expo-haptics": "~57.0.0",
    "expo-image-manipulator": "~57.0.1",
    "expo-image-picker": "~57.0.2",
    "expo-location": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-sharing": "~57.0.3",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.4",
    "llama.rn": "^0.12.5",
    "react": "19.2.3",
    "react-cartoon-planet": "^1.1.2",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-executorch": "^0.9.2",
    "react-native-executorch-expo-resource-fetcher": "^0.9.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.0",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@types/react": "~19.2.17",
    "@types/three": "^0.185.1",
    "autoevals": "^0.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.2",
    "eas-cli": "^20.5.1",
    "evalite": "^0.19.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "llama.rn"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
